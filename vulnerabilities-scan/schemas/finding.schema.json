{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vulnerabilities-scan/schemas/finding.schema.json",
  "title": "Repository security audit findings dataset",
  "description": "Single source of truth for one audit run. Every report format is generated from this document. Implements the 20 mandatory finding fields specified in references/reporting-standard.md, with controlled vocabularies for severity, confidence and validation_status.",
  "type": "object",
  "required": ["schema_version", "findings"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0",
      "description": "Dataset format version. Breaking changes bump this."
    },
    "audit": {
      "type": "object",
      "description": "Snapshot identity. Without it findings cannot be reproduced or attributed.",
      "additionalProperties": true,
      "properties": {
        "repository": { "type": ["string", "null"] },
        "commit": { "type": ["string", "null"] },
        "branch": { "type": ["string", "null"] },
        "dirty": { "type": "boolean" },
        "audited_at": { "type": "string", "description": "ISO-8601 UTC timestamp" },
        "scope_path": { "type": "string" },
        "excluded": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Exclusions are limits on the audit's claims and must be reported."
        }
      }
    },
    "generated_by": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "skill": { "type": "string" },
        "skill_version": { "type": "string" },
        "python": { "type": "string" }
      }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "negative_findings": {
      "type": "array",
      "description": "Checks performed and passed. Rendered separately and never counted as vulnerabilities.",
      "items": {
        "type": "object",
        "required": ["check", "scope", "result"],
        "additionalProperties": true,
        "properties": {
          "check": { "type": "string" },
          "scope": { "type": "string" },
          "result": { "type": "string", "enum": ["passed", "mitigated", "not_applicable"] },
          "evidence": { "type": ["string", "null"] },
          "notes": { "type": ["string", "null"] }
        }
      }
    },
    "coverage": {
      "type": "object",
      "description": "What was and was not examined. A report may never omit this.",
      "additionalProperties": true,
      "properties": {
        "scanners": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "available"],
            "additionalProperties": true,
            "properties": {
              "name": { "type": "string" },
              "available": { "type": "boolean" },
              "version": { "type": ["string", "null"] },
              "reason": { "type": ["string", "null"] },
              "covers": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "files_examined": { "type": "integer", "minimum": 0 },
        "files_skipped": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "reason"],
            "additionalProperties": true,
            "properties": {
              "path": { "type": "string" },
              "reason": {
                "type": "string",
                "enum": ["binary", "too_large", "unreadable", "generated", "excluded", "unsupported_language", "submodule"]
              }
            }
          }
        },
        "limitations": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "description": "One validated finding. All 20 fields are mandatory; absence is expressed as an explicit null or a marker value, never by omission.",
      "required": [
        "id", "title", "category", "severity", "confidence", "validation_status",
        "cwe", "owasp", "cvss_vector", "cvss_score", "location", "language",
        "evidence", "description", "impact", "attack_scenario", "recommended_fix",
        "references", "sources", "priority"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^VULN-[0-9]{3,4}$",
          "description": "Deterministic: assigned after deduplication, ordered by severity, file, line."
        },
        "title": { "type": "string", "minLength": 3, "maxLength": 200 },
        "category": {
          "type": "string",
          "enum": [
            "sql_injection", "nosql_injection", "command_injection", "code_injection",
            "ssti", "ldap_injection", "xpath_injection", "header_injection",
            "xss_reflected", "xss_stored",
            "path_traversal", "unrestricted_upload", "zip_slip",
            "ssrf", "open_redirect", "tls_verification_disabled",
            "missing_authentication", "weak_password_hashing", "weak_jwt_validation", "session_management",
            "missing_authorization", "idor", "missing_function_level_authorization", "csrf",
            "business_logic", "missing_rate_limiting", "race_condition", "mass_assignment",
            "weak_randomness", "hardcoded_secret", "broken_crypto", "sensitive_data_exposure",
            "insecure_deserialization", "unsigned_update",
            "vulnerable_dependency", "unpinned_dependency",
            "permissive_cors", "missing_security_headers", "debug_mode",
            "container_security", "cicd_permissions", "iac_misconfiguration", "kubernetes_security",
            "fail_open_error_handling",
            "unclassified"
          ],
          "description": "Taxonomy class from references/vulnerability-taxonomy.md. Use unclassified rather than inventing a value."
        },
        "severity": {
          "type": "string",
          "enum": ["Critical", "High", "Medium", "Low", "Informational"],
          "description": "Derived from the CVSS 4.0 base score bands, never assigned by feel."
        },
        "confidence": {
          "type": "string",
          "enum": ["CONFIRMED", "HIGH", "MEDIUM", "LOW"],
          "description": "Analytic certainty, per references/validation-methodology.md. Independent of severity."
        },
        "validation_status": {
          "type": "string",
          "enum": ["unvalidated", "validated", "needs_review", "suppressed"],
          "description": "Pipeline state. A report must never contain unvalidated findings as vulnerabilities."
        },
        "cwe": {
          "type": "object",
          "required": ["id"],
          "additionalProperties": true,
          "properties": {
            "id": { "type": "string", "pattern": "^CWE-[0-9]{1,5}$" },
            "name": { "type": ["string", "null"] }
          }
        },
        "owasp": {
          "type": "object",
          "description": "Mappings are stated or explicitly absent. Never invent an identifier.",
          "additionalProperties": true,
          "required": ["top10_2025"],
          "properties": {
            "top10_2025": {
              "oneOf": [
                { "type": "null" },
                { "type": "string", "pattern": "^A(0[1-9]|10):2025$" },
                { "type": "string", "const": "not mapped" }
              ]
            },
            "api_2023": {
              "oneOf": [
                { "type": "null" },
                { "type": "string", "pattern": "^API([1-9]|10):2023$" },
                { "type": "string", "const": "not mapped" }
              ]
            },
            "asvs": {
              "oneOf": [
                { "type": "null" },
                { "type": "string", "pattern": "^v5\\.0\\.0-[0-9]+\\.[0-9]+\\.[0-9]+$" },
                { "type": "string", "const": "not mapped" }
              ]
            }
          }
        },
        "cvss_vector": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^CVSS:4\\.0/[A-Z]{1,3}:[A-Za-z](?:/[A-Z]{1,3}:[A-Za-z]){10,}$" }
          ],
          "description": "Full CVSS 4.0 vector string including the version prefix; null when unscored."
        },
        "cvss_score": {
          "oneOf": [
            { "type": "null" },
            { "type": "number", "minimum": 0.0, "maximum": 10.0 }
          ],
          "description": "Computed by the bundled FIRST reference port. Never hand-written."
        },
        "scoring": {
          "type": "string",
          "enum": ["scored", "unscored"],
          "description": "Explicit marker. unscored requires cvss_vector and cvss_score to be null."
        },
        "location": {
          "type": "object",
          "required": ["file", "line_start", "line_end"],
          "additionalProperties": true,
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])",
              "description": "Path relative to the audited root, forward slashes, 1-based lines."
            },
            "line_start": { "type": "integer", "minimum": 1 },
            "line_end": { "type": "integer", "minimum": 1 }
          }
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "description": "python, javascript, typescript, go, ruby, php, java, csharp, dockerfile, terraform, kubernetes, github-actions, yaml, json, ..."
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "description": "Redacted source excerpt with line numbers. Secrets are replaced at ingestion."
        },
        "description": { "type": "string", "minLength": 10 },
        "impact": { "type": "string", "minLength": 10 },
        "attack_scenario": { "type": "string", "minLength": 10 },
        "recommended_fix": { "type": "string", "minLength": 10 },
        "references": {
          "type": "array",
          "items": { "type": "string", "minLength": 3 },
          "description": "CWE/OWASP/ASVS links and standards citations."
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["tool"],
            "additionalProperties": true,
            "properties": {
              "tool": { "type": "string", "minLength": 1 },
              "rule_id": { "type": ["string", "null"] },
              "raw_ref": { "type": ["string", "null"] }
            }
          },
          "description": "Provenance: every engine that reported it. Merging preserves this list."
        },
        "priority": {
          "type": "string",
          "enum": ["P0", "P1", "P2", "P3"]
        },
        "priority_factors": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Why this priority: severity, confidence, exposure, reachability, exploit availability."
        },
        "suppression_reason": {
          "type": ["string", "null"],
          "description": "Required when validation_status is suppressed; the record is kept so the next audit does not rediscover it."
        },
        "suppression_kind": {
          "type": ["string", "null"],
          "enum": ["false_positive", "not_exploitable", "accepted_risk", null],
          "description": "Why a suppressed finding was closed: false_positive (the flaw is not there), not_exploitable (it is there but unreachable) or accepted_risk (real, reachable, signed off). Decides which suppressed/ directory the finding is filed in; absent, it is filed as unspecified."
        },
        "locations": {
          "type": "array",
          "description": "Additional sites for one root cause (copy-pasted helper).",
          "items": {
            "type": "object",
            "required": ["file", "line_start", "line_end"],
            "properties": {
              "file": { "type": "string" },
              "line_start": { "type": "integer", "minimum": 1 },
              "line_end": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "validation": {
          "type": ["string", "null"],
          "description": "The steps and control searches performed, so a reader can audit the auditor."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "cvss_score": { "type": "null" } }, "required": ["cvss_score"] },
          "then": { "properties": { "cvss_vector": { "type": "null" } } }
        },
        {
          "if": { "properties": { "cvss_vector": { "type": "null" } }, "required": ["cvss_vector"] },
          "then": { "properties": { "cvss_score": { "type": "null" } } }
        },
        {
          "if": { "properties": { "validation_status": { "const": "suppressed" } }, "required": ["validation_status"] },
          "then": {
            "required": ["suppression_reason"],
            "properties": { "suppression_reason": { "type": "string", "minLength": 3 } }
          }
        },
        {
          "if": { "properties": { "suppression_kind": { "type": "string" } }, "required": ["suppression_kind"] },
          "then": { "properties": { "validation_status": { "const": "suppressed" } } }
        },
        {
          "if": { "properties": { "severity": { "const": "Informational" } } },
          "then": {
            "properties": {
              "cvss_score": { "type": ["null", "number"] }
            }
          }
        }
      ]
    }
  }
}
